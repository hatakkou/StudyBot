# Discord Bot Token (https://discord.com/developers/applications から取得)
DISCORD_TOKEN=your_bot_token_here
# 任意: ギルドIDを入れるとスラッシュコマンド同期が高速（開発用）
GUILD_ID=
# 任意: 勉強部屋VCのID（カンマ区切り）。空なら全VCを記録対象
STUDY_VOICE_CHANNEL_IDS=
# 任意: 常設パネルのテキストチャンネルID（panel固定用）
STUDY_PANEL_CHANNEL_ID=
# 任意: 勉強開始を本人だけに通知するテキストチャンネルID（未設定ならPANELと同じ/DMのみ）
STUDY_NOTIFY_CHANNEL_ID=
# レポート投稿先チャンネルID（日報など）
REPORT_CHANNEL_ID=
# 年組オンボーディング（最初に年組を入力してロール付与）
# ONBOARDING_CHANNEL_ID: 年組入力を受け付ける専用チャンネルID（パネル設置先と基本同じにする）
ONBOARDING_CHANNEL_ID=
# 任意: ロール名がデフォルトと違う場合は "表示名:ロールID" でマッピング（カンマ区切り）
# ONBOARDING_YEAR_ROLES="1年:123,2年:234,3年:345"
# ONBOARDING_CLASS_ROLES="1組:111,2組:222,3組:333"
ONBOARDING_YEAR_ROLES=
ONBOARDING_CLASS_ROLES=
# 任意: 選択肢を変えたい場合（カンマ区切り）
# ONBOARDING_YEARS="1年,2年,3年"
# ONBOARDING_CLASSES="1組,2組,3組,4組,5組,6組"
ONBOARDING_YEARS=
ONBOARDING_CLASSES=
# テキスト入力の自動削除（秒, 0で削除しない）
ONBOARDING_AUTO_DELETE_SEC=10
# タイムゾーン
TZ=Asia/Tokyo
