# Discord Bot Token (https://discord.com/developers/applications から取得)
DISCORD_TOKEN=your_bot_token_here
# 任意: ギルドIDを入れるとスラッシュコマンド同期が高速（開発用）
GUILD_ID=
# 任意: 勉強部屋VCのID（カンマ区切り）。空なら全VCを記録対象
STUDY_VOICE_CHANNEL_IDS=
# 任意: 常設パネルのテキストチャンネルID（panel固定用）
STUDY_PANEL_CHANNEL_ID=
# 任意: 勉強開始を本人だけに通知するテキストチャンネルID（未設定ならPANELと同じ/DMのみ）
STUDY_NOTIFY_CHANNEL_ID=
# レポート投稿先チャンネルID（日報など）
REPORT_CHANNEL_ID=
# タイムゾーン
TZ=Asia/Tokyo
